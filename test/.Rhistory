burundi_crs <- readRDS("../data/bdi_result_crs.rds")
library(visNetwork)
library(tidygraph)
library(dplyr)
library(DT)
# Subsetting to Burundi's 2005 data
burundi_crs_2005 <- burundi_crs[["edge_lists"]][["2005"]]
View(burundi_crs_2005)
library(sigmajs)
# generate data
nodes <- sg_make_nodes(25) # 20 nodes
View(nodes)
edges <- sg_make_edges(nodes, 50) # 50 edges
View(edges)
sg_nodes <- burundi_crs_2005 %>%
mutate(id = sender, group = sender_orgtype) %>%
select(id, group) %>%
bind_rows(
burundi_crs_2005 %>%
mutate(id = receiver, group = receiver_orgtype) %>%
select(id, group)
) %>%
distinct(id, .keep_all = TRUE) %>%
mutate(label = id)
View(sg_nodes)
View(nodes)
View(burundi_crs)
View(burundi_crs_2005)
View(nodes)
color = #000000)
View(sg_nodes)
sg_nodes <- sg_nodes %>%
mutate(size = 3,
color = 000000)
View(sg_nodes)
sg_nodes <- sg_nodes %>%
mutate(size = 3,
color = "#000000")
View(sg_nodes)
sg_nodes <- sg_nodes %>%
mutate(size = 3,
color = "#000000") %>%
select(id, label, size, color, everthing())
library(dplyr)
sg_nodes <- sg_nodes %>%
mutate(size = 3,
color = "#000000") %>%
select(id, label, size, color, everthing())
sg_nodes <- sg_nodes %>%
mutate(size = 3,
color = "#000000") %>%
select(id, label, size, color, everything())
View(sg_nodes)
View(edges)
View(burundi_crs)
View(burundi_crs_2005)
sg_edges <- burundi_crs_2005 %>%
mutate(source = sender, target = receiver) %>%
select(id, source, target)
View(sg_edges)
View(sg_nodes)
sigmajs() %>% # initialise
