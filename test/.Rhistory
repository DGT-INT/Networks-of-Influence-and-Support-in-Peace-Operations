library(sigmajs)
set.seed(123)
# generate data
nodes <- sg_make_nodes(25) # 20 nodes
edges <- sg_make_edges(nodes, 50) # 50 edges
nodes <- nodes %>%
mutate(label = id)
sigmajs() %>% # initialise
sg_nodes(nodes, id, label, size) %>% # add nodes
sg_edges(edges, id, source, target)
View(edges)
View(test_edges)
