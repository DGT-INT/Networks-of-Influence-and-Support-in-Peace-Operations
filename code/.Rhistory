sort()
first_year <- min(years)
last_year  <- max(years)
# subsetting country crs data by year
for (i in first_year:last_year) {
COUNTRY_crs_i <- COUNTRY_crs[["edge_lists"]][[as.character(i)]]
COUNTRY_crs_i <- COUNTRY_crs_i %>%
mutate(Country = COUNTRY, Year = i)
assign(paste0(COUNTRY, "_crs_", i), COUNTRY_crs_i)
}
# appending to make 1 crs dataset per country
COUNTRY_crs_all_years <- bind_rows(
mget(paste0(COUNTRY, "_crs_", first_year:last_year))
)
# cleaning the environment
rm(list = paste0(COUNTRY, "_crs_", first_year:last_year), COUNTRY_crs_i, COUNTRY_crs)
}
View(COUNTRY_crs_all_years)
